{
  "expo": {
    "name": "Pick&Pay",
    "slug": "pickandpay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-1024.png",
    "scheme": "pickandpay",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pickandpay.app",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:pickandpay.app"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "Pick&Pay needs camera access to scan receipts.",
        "NSPhotoLibraryUsageDescription": "Pick&Pay needs photo library access to upload receipts.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.jpg",
        "backgroundColor": "#0A0A0F"
      },
      "package": "com.pickandpay.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "pickandpay"
            },
            {
              "scheme": "https",
              "host": "pickandpay.app",
              "pathPrefix": "/session"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Pick&Pay needs camera access to scan receipts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick&Pay needs photo library access to upload receipts."
        }
      ],
      "expo-notifications",
      "expo-font",
      "expo-mail-composer",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "276971a9-0129-4e94-a872-69fc16a615cd"
      }
    }
  }
}
